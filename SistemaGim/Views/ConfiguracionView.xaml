<UserControl x:Class="SistemaGim.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             FontFamily="{DynamicResource MaterialDesignDefaultFont}"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: FORMULARIO -->
        <materialDesign:Card Grid.Row="0" Margin="0 0 0 20" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2" Background="White">
            <StackPanel Margin="20">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                    <materialDesign:PackIcon Kind="CashRegister" Width="32" Height="32" Foreground="#673AB7" VerticalAlignment="Center"/>
                    <TextBlock Text="Configuración de Precios (Membresías y Sesiones)" FontSize="22" FontWeight="Bold" Margin="10 0 0 0" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Margin="0 0 0 20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtConcepto" Grid.Column="0"
                             materialDesign:HintAssist.Hint="Concepto (Ej: Sesión Diaria) *" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="15"/>

                    <TextBox x:Name="TxtMonto" Grid.Column="2"
                             materialDesign:HintAssist.Hint="Monto (C$) *" 
                             PreviewTextInput="ValidarSoloDecimales"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="15"/>

                    <TextBox x:Name="TxtDias" Grid.Column="4"
                             materialDesign:HintAssist.Hint="Días de Vigencia *" 
                             PreviewTextInput="ValidarSoloNumeros"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="15"/>
                </Grid>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtEstadoFormulario" Text="Creando nuevo precio" Foreground="Gray" FontStyle="Italic" VerticalAlignment="Center" Margin="0 0 20 0"/>

                    <Button Click="BtnLimpiar_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#2196F3" Height="40" Margin="5 0" Content="NUEVO"/>
                    <Button Click="BtnGuardar_Click" Background="#4CAF50" BorderBrush="#4CAF50" Foreground="White" Height="40" Margin="5 0" Content="GUARDAR / EDITAR"/>
                    <Button x:Name="BtnEliminar" Click="BtnEliminar_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#F44336" Foreground="#F44336" Height="40" Margin="15 0 0 0" Content="ELIMINAR" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- PANEL INFERIOR: TABLA -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2" Background="White">
            <DataGrid x:Name="DgPrecios" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" SelectionChanged="DgPrecios_SelectionChanged"
                      Background="White" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0" BorderThickness="0" RowHeight="45">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ConfigId}" Width="80"/>
                    <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                    <DataGridTextColumn Header="Monto (C$)" Binding="{Binding Monto, StringFormat='C$ {0:N2}'}" Width="150"/>
                    <DataGridTextColumn Header="Días de Vigencia" Binding="{Binding DiasVigencia}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>