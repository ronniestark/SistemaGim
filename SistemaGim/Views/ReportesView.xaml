<UserControl x:Class="SistemaGim.Views.ReportesView"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             FontFamily="{DynamicResource MaterialDesignDefaultFont}"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filtros -->
            <RowDefinition Height="*"/>
            <!-- Previsualización -->
        </Grid.RowDefinitions>

        <!-- PANEL DE FILTROS -->
        <materialDesign:Card Grid.Row="0" Margin="0 0 0 20" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2" Background="White">
            <StackPanel Margin="20">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                    <materialDesign:PackIcon Kind="FileChart" Width="32" Height="32" Foreground="#673AB7" VerticalAlignment="Center"/>
                    <TextBlock Text="Generación de Reportes" FontSize="22" FontWeight="Bold" Margin="10 0 0 0" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbTipoReporte" Grid.Column="0" materialDesign:HintAssist.Hint="Tipo de Reporte *" Style="{StaticResource MaterialDesignFloatingHintComboBox}" FontSize="15" SelectionChanged="CmbTipoReporte_SelectionChanged">
                        <ComboBoxItem Content="Estado de Ganancias e Ingresos"/>
                        <ComboBoxItem Content="Estadísticas de Visitas"/>
                    </ComboBox>

                    <DatePicker x:Name="DpInicio" Grid.Column="2" materialDesign:HintAssist.Hint="Fecha Inicio *" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" FontSize="15"/>

                    <DatePicker x:Name="DpFin" Grid.Column="4" materialDesign:HintAssist.Hint="Fecha Fin *" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" FontSize="15"/>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Click="BtnGenerarVista_Click" Background="#2196F3" BorderBrush="#2196F3" Foreground="White" Height="40" Margin="0 0 15 0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Eye" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="PREVISUALIZAR" Margin="8 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnExportarPdf_Click" Background="#F44336" BorderBrush="#F44336" Foreground="White" Height="40" Margin="0 0 10 0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="DESCARGAR PDF" Margin="8 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnExportarExcel_Click" Background="#4CAF50" BorderBrush="#4CAF50" Foreground="White" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelBox" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="EXCEL" Margin="8 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- PANEL DE VISUALIZACIÓN (PREVIEW TIPO IFRAME) -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2" Background="White">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtTituloVista" Text="Visualizador de Documento" FontSize="16" FontWeight="SemiBold" Foreground="Gray" Margin="10 10 10 15" Grid.Row="0"/>

                <!-- Contenedor del PDF nativo de Windows -->
                <!-- Contenedor del PDF nativo moderno -->
                <wv2:WebView2 x:Name="PdfViewer" Grid.Row="1" Margin="10" />
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>