<UserControl x:Class="SistemaGim.Views.VisitasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             FontFamily="{DynamicResource MaterialDesignDefaultFont}"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: REGISTRO RÁPIDO -->
        <materialDesign:Card Grid.Row="0" Margin="0 0 0 20" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2" Background="White">
            <StackPanel Margin="20">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                    <materialDesign:PackIcon Kind="AccountClock" Width="32" Height="32" Foreground="#4CAF50" VerticalAlignment="Center"/>
                    <TextBlock Text="Registro Rápido de Visita Diaria" FontSize="22" FontWeight="Bold" Margin="10 0 0 0" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Margin="0 0 0 20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buscador de Cliente (IsEditable="True" permite escribir para buscar) -->
                    <ComboBox x:Name="CmbClientes" Grid.Column="0"
                              materialDesign:HintAssist.Hint="Seleccione o busque al cliente *" 
                              IsEditable="True"
                              DisplayMemberPath="NombreCompleto" 
                              SelectedValuePath="ClienteId"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" FontSize="16" Height="45"/>

                    <TextBox x:Name="TxtFechaHoy" Grid.Column="2"
                             materialDesign:HintAssist.Hint="Fecha de Visita" 
                             IsReadOnly="True" Foreground="Gray"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="16" Height="45"/>

                    <TextBox x:Name="TxtMontoSesion" Grid.Column="4"
                             materialDesign:HintAssist.Hint="Total a Pagar (C$)" 
                             IsReadOnly="True" Foreground="#4CAF50" FontWeight="Bold"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="16" Height="45"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtAlertaPrecio" Text="Cargando precio de sesión..." Foreground="Red" FontStyle="Italic" VerticalAlignment="Center" Margin="0 0 20 0" Visibility="Hidden"/>
                    <Button x:Name="BtnCobrar" Click="BtnCobrar_Click" Background="#4CAF50" BorderBrush="#4CAF50" Foreground="White" Height="45" Padding="20 0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="COBRAR SESIÓN Y REGISTRAR ENTRADA" Margin="10 0 0 0" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- PANEL INFERIOR: VISITAS DEL DÍA -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Asistencias de Hoy" FontSize="18" FontWeight="SemiBold" Margin="20 15"/>

                <DataGrid x:Name="DgVisitasHoy" Grid.Row="1" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="White" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0" BorderThickness="0" RowHeight="45">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat='HH:mm tt'}" Width="120"/>
                        <DataGridTextColumn Header="Nombre del Cliente" Binding="{Binding Cliente.NombreCompleto}" Width="*"/>
                        <DataGridTextColumn Header="Monto Pagado" Binding="{Binding Pago.Monto, StringFormat='C$ {0:N2}'}" Width="150"/>
                        <DataGridTextColumn Header="Concepto" Binding="{Binding Pago.Concepto}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>