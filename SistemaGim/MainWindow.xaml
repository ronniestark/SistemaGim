<Window x:Class="SistemaGim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gym Manager Pro" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="#F5F6FA"
        FontFamily="{DynamicResource MaterialDesignDefaultFont}">

    <materialDesign:DialogHost Identifier="RootDialog">

        <materialDesign:DrawerHost x:Name="MenuLateral" OpenMode="Standard">

            <!-- 1. CONTENIDO DEL MENÚ LATERAL (Fondo oscuro explícito) -->
            <materialDesign:DrawerHost.LeftDrawerContent>

                <Border Width="260" Background="#1E1E2D" BorderThickness="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera del Menú -->
                        <StackPanel Grid.Row="0" Margin="0 30 0 20">
                            <materialDesign:PackIcon Kind="Dumbbell" Width="60" Height="60" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="GYM MANAGER" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 10 0 5"/>
                            <TextBlock Text="Sistema de Control" Foreground="#A0A0A0" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Lista de Botones -->
                        <StackPanel Grid.Row="1" Margin="10 20 10 0">

                            <!-- Botón Dashboard -->
                            <Button Click="BtnDashboard_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FFFFFF" HorizontalAlignment="Stretch" Height="50" HorizontalContentAlignment="Left" Margin="0 0 0 5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewDashboard" Width="22" Height="22" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                    <TextBlock Text="Dashboard" Margin="20 0 0 0" VerticalAlignment="Center" FontSize="15"/>
                                </StackPanel>
                            </Button>

                            <!-- Botón Clientes -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FFFFFF" HorizontalAlignment="Stretch" Height="50" HorizontalContentAlignment="Left" Margin="0 0 0 5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                    <TextBlock Text="Clientes" Margin="20 0 0 0" VerticalAlignment="Center" FontSize="15"/>
                                </StackPanel>
                            </Button>

                            <!-- Botón Visitas Diarias -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FFFFFF" HorizontalAlignment="Stretch" Height="50" HorizontalContentAlignment="Left" Margin="0 0 0 5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountClock" Width="22" Height="22" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                    <TextBlock Text="Visitas Diarias" Margin="20 0 0 0" VerticalAlignment="Center" FontSize="15"/>
                                </StackPanel>
                            </Button>

                            <!-- Botón Miembros / Membresías -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FFFFFF" HorizontalAlignment="Stretch" Height="50" HorizontalContentAlignment="Left" Margin="0 0 0 5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CardAccountDetails" Width="22" Height="22" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                    <TextBlock Text="Membresías" Margin="20 0 0 0" VerticalAlignment="Center" FontSize="15"/>
                                </StackPanel>
                            </Button>

                            <!-- Botón Inventario Máquinas -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FFFFFF" HorizontalAlignment="Stretch" Height="50" HorizontalContentAlignment="Left" Margin="0 0 0 5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Weight" Width="22" Height="22" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                    <TextBlock Text="Inventario Máquinas" Margin="20 0 0 0" VerticalAlignment="Center" FontSize="15"/>
                                </StackPanel>
                            </Button>

                            <!-- Botón Reportes -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FFFFFF" HorizontalAlignment="Stretch" Height="50" HorizontalContentAlignment="Left" Margin="0 0 0 5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Finance" Width="22" Height="22" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                    <TextBlock Text="Reportes" Margin="20 0 0 0" VerticalAlignment="Center" FontSize="15"/>
                                </StackPanel>
                            </Button>

                            <!-- Botón Configuración -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FFFFFF" HorizontalAlignment="Stretch" Height="50" HorizontalContentAlignment="Left" Margin="0 0 0 5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" VerticalAlignment="Center" Margin="10 0 0 0"/>
                                    <TextBlock Text="Configuración" Margin="20 0 0 0" VerticalAlignment="Center" FontSize="15"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Footer Menú -->
                        <TextBlock Grid.Row="2" Text="v1.0" Foreground="#707070" HorizontalAlignment="Center" Margin="0 0 0 20"/>
                    </Grid>
                </Border>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <!-- 2. CONTENIDO PRINCIPAL (Derecha) -->
            <DockPanel>

                <!-- Barra Superior (App Bar) -->
                <materialDesign:ColorZone Background="#673AB7" Padding="16" materialDesign:ElevationAssist.Elevation="Dp3" DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botón Hamburguesa -->
                        <ToggleButton Grid.Column="0" Style="{StaticResource MaterialDesignHamburgerToggleButton}" 
                                      IsChecked="{Binding ElementName=MenuLateral, Path=IsLeftDrawerOpen}" 
                                      Foreground="White" Width="32" Height="32"/>

                        <TextBlock Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="18" Foreground="White" Text="Panel de Administración" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BellOutline" Width="24" Height="24" VerticalAlignment="Center" Margin="0 0 15 0" Foreground="White"/>
                            <materialDesign:PackIcon Kind="AccountCircle" Width="32" Height="32" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:ColorZone>

                <!-- Contenedor de pantallas -->
                <Border Background="#F5F6FA">
                    <ContentControl x:Name="MainContent" Margin="20"/>
                </Border>

            </DockPanel>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>